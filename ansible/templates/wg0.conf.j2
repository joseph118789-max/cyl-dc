[Interface]
Address = {{ wireguard_internal_ip }}
PrivateKey = {{ wg_private_key }}
ListenPort = {{ wireguard_listen_port }}
MTU = 1420

{% for peer in wireguard_peers %}
{% if peer.wireguard_ip != wireguard_internal_ip %}
[Peer]
PublicKey = {{ peer.wg_public_key }}
AllowedIPs = {{ peer.wireguard_ip }}
Endpoint = {{ peer.ansible_host }}:51820
PersistentKeepalive = 25
{% endif %}
{% endfor %}