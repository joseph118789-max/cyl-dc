# Patroni config for witness node ({{ inventory_hostname }})
# Managed by Ansible – cyl-dc/ansible/playbooks/patroni-ha.yml
#
# This node is a WITNESS ONLY – it participates in etcd quorum but
# never holds Postgres data. Tags prevent failover/sync to this node.
#
# Cluster: cyl-dc-pg
# DCS: etcd (all 3 members)

name: {{ inventory_hostname }}

scope: cyl-dc-pg
namespace: db/
dcs:
  ttl: 30
  loop_wait: 10
  retry_timeout: 10
  maximum_lag_on_failover: 1048576
  postgresql:
    use_pg_rewind: false
    use_slots: false
    parameters:
      max_connections: 50
      shared_buffers: 64MB
      listen_addresses: "0.0.0.0"
      port: {{ pg_port }}

etcd:
  hosts: "{{ etcd_dcs }}"
  timeout: 10
  retry_timeout: 10

postgresql:
  listen: "0.0.0.0:{{ pg_port }}"
  connect_address: "{{ inventory_hostname }}:{{ pg_port }}"
  data_dir: "/var/lib/patroni-witness"
  bin_dir: "/usr/lib/postgresql/{{ pg_version }}/bin"
  authentication:
    replication:
      username: replicator
      password: "replicator_password"
    superuser:
      username: postgres
      password: "postgres_password"

# WITNESS TAGS – this node is a tie-breaker only
tags:
  nofailover: true
  nosync: true
  clonefrom: false

# No watchdog on witness (can't fence itself)
watchdog:
  mode: off

# Bootstrap is not needed – witness doesn't init a cluster
# It joins an existing cluster via DCS
