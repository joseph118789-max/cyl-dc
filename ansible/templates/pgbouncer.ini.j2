# PgBouncer config for Patroni HA PostgreSQL
# Managed by Ansible – cyl-dc/ansible/playbooks/patroni-haproxy.yml
#
# pool_mode = transaction: connection returned after each transaction.
# Works with Patroni — app must handle reconnection on leader change.
#
# Design: each node's PgBouncer pools ONLY its local Postgres (127.0.0.1).
# HAProxy handles leader/replica routing across nodes.
# PgBouncer adds connection pooling on each DB node — no cross-node routing.
#
# Traffic flow (no keepalived):
#   client → HAProxy on chosen node → local Postgres on :5432
#                                 → or via PgBouncer on :5000 (local only)
# With keepalived VIP:
#   client → HAProxy on leader → local Postgres direct or via PgBouncer

[databases]
postgres = host=127.0.0.1 port={{ pg_port }} dbname=postgres

[pgbouncer]
listen_addr = 0.0.0.0
listen_port = {{ pgbouncer_port }}
auth_type = md5
auth_file = /etc/pgbouncer/userlist.txt
logfile = /var/log/pgbouncer/pgbouncer.log
pidfile = /run/pgbouncer/pgbouncer.pid
pool_mode = transaction
max_client_conn = 200
default_pool_size = 20
min_pool_size = 5
reserve_pool_size = 5
reserve_pool_timeout = 5
max_db_connections = 50
max_user_connections = 100
server_reset_query = DISCARD ALL
server_check_delay = 30
server_lifetime = 3600
server_idle_timeout = 600
query_timeout = 0
client_login_timeout = 60
server_connect_timeout = 5
